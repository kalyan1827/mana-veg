{
  "name": "admin",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-14",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "services": [
    {
      "binding": "BACKEND",
      "service": "manankuragayalu-backend"
    }
  ]
}
